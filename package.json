{
	"name": "controlforge-systems-website",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:analyze": "vite build --mode analyze",
		"build:prod": "NODE_ENV=production vite build --minify terser",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"lint:eslint": "eslint .",
		"lint:eslint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"validate": "./scripts/pre-deployment-check.sh",
		"prod:build": "pnpm prebuild && pnpm build:prod",
		"prod:deploy": "pnpm prod:build && pnpm deploy:pages",
		"deploy:pages": "cf pages deploy build --project-name=controlforge-website --branch=main --commit-dirty=true",
		"deploy:preview": "cf pages deploy build --project-name=controlforge-website --branch=preview --commit-dirty=true",
		"prebuild": "node scripts/generate-build-info.cjs && node scripts/generate-sitemap.cjs",
		"postinstall": "node scripts/generate-build-info.cjs",
		"prepare": "husky"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.51.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^25.2.3",
		"@typescript-eslint/eslint-plugin": "^8.55.0",
		"@typescript-eslint/parser": "^8.55.0",
		"eslint": "^10.0.0",
		"eslint-plugin-svelte": "^3.15.0",
		"globals": "^17.3.0",
		"husky": "^9.1.7",
		"prettier": "^3.2.5",
		"prettier-plugin-svelte": "^3.2.2",
		"rollup-plugin-visualizer": "^6.0.3",
		"shiki": "^3.22.0",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.0",
		"svelte-eslint-parser": "^1.4.1",
		"tailwindcss": "^4.1.18",
		"terser": "^5.42.0",
		"tslib": "^2.6.2",
		"typescript": "^5.4.2",
		"vite": "^7.3.1",
		"vite-bundle-analyzer": "^1.3.6",
		"vite-plugin-devtools-json": "^1.0.0"
	},
	"type": "module",
	"dependencies": {
		"@sveltejs/adapter-static": "^3.0.1"
	}
}
